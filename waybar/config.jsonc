// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "height": 30,
    "margin-top": 4,
    "margin-left": 6,
    "margin-right": 6,
    "margin-bottom": 0,
    "spacing": 0,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/layout",
        "custom/session",
        "tray"
    ],
    "modules-center": [
        "clock",
        "clock#date"
    ],
    "modules-right": [
        "wireplumber",
        "custom/cpu",
        "temperature",
        "custom/mem",
        "custom/gpu",
        "custom/vram",
        "custom/net",
        "custom/vpn",
        "bluetooth",
        "custom/bashirov",
        "custom/host6",
        "custom/lan"
    ],
    "custom/layout": {
        "exec": "python3 $HOME/.config/waybar/scripts/layout.py",
        "return-type": "json",
        "interval": 1,
        "tooltip": true
    },
    "custom/session": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "logout / suspend",
        "on-click": "$HOME/.config/waybar/scripts/session.sh"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 6
    },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A %d.%m.%Y}\n{calendar}",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "format": {
                "today": "<span color='#fcee0a'><b>{}</b></span>"
            }
        }
    },
    "clock#date": {
        "interval": 60,
        "format": "{:%d.%m.%Y}",
        "tooltip": false
    },
    "wireplumber": {
        "format": "{volume}% {icon}",
        "format-muted": "muted {icon}",
        "format-icons": ["", "", ""],
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": true
    },
    "custom/cpu": {
        "exec": "python3 $HOME/.config/waybar/scripts/cpu.py",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "interval": 2,
        "critical-threshold": 85,
        "warning-threshold": 70,
        "format": "{temperatureC}°C {icon}",
        "format-warning": "{temperatureC}°C {icon}",
        "format-critical": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""],
        "tooltip": true,
        "tooltip-format": "CPU {temperatureC}°C"
    },
    "custom/mem": {
        "exec": "python3 $HOME/.config/waybar/scripts/mem.py",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "custom/gpu": {
        "exec": "python3 $HOME/.config/waybar/scripts/gpu.py",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "custom/vram": {
        "exec": "python3 $HOME/.config/waybar/scripts/vram.py",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "custom/net": {
        "exec": "python3 $HOME/.config/waybar/scripts/net.py",
        "return-type": "json",
        "interval": 5,
        "tooltip": true
    },
    "custom/vpn": {
        "exec": "python3 $HOME/.config/waybar/scripts/vpn.py",
        "return-type": "json",
        "interval": 10,
        "tooltip": true,
        "on-click": "$HOME/.config/waybar/scripts/vpn-toggle.sh"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "bt",
        "format-off": "bt",
        "format-connected": "",
        "tooltip-format": "{controller_alias} {status}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },
    "custom/host6": {
        "exec": "python3 $HOME/.config/waybar/scripts/host6.py",
        "return-type": "json",
        "interval": 30,
        "tooltip": true
    },
    "custom/bashirov": {
        "exec": "python3 $HOME/.config/waybar/scripts/bashirov.py",
        "return-type": "json",
        "interval": 60,
        "tooltip": true,
        "markup": "pango"
    },
    "custom/lan": {
        "exec": "python3 $HOME/.config/waybar/scripts/lan.py",
        "return-type": "json",
        "interval": 30,
        "tooltip": true
    }
}
