+
+void
+writelayout(struct wlr_keyboard *keyboard)
+{
+	xkb_layout_index_t idx;
+	const char *rt, *label;
+	char path[256];
+	FILE *f;
+
+	if (!keyboard || !keyboard->xkb_state)
+		return;
+	idx = xkb_state_serialize_layout(keyboard->xkb_state,
+			XKB_STATE_LAYOUT_EFFECTIVE);
+	label = idx == 1 ? "ru" : idx == 0 ? "en" : "??";
+	rt = getenv("XDG_RUNTIME_DIR");
+	if (!rt)
+		return;
+	if (snprintf(path, sizeof(path), "%s/dwl-layout", rt) >= (int)sizeof(path))
+		return;
+	f = fopen(path, "w");
+	if (!f)
+		return;
+	fputs(label, f);
+	fputc('\n', f);
+	fclose(f);
 }
 
